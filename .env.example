# ===================================================================
# SHIORI API - Environment Variables Example (.env.example)
# Copie este arquivo para .env e gere suas chaves via CLI:
#   openssl rand -hex 32
# ===================================================================

# Configurações do Servidor
PORT=8080

# Banco de Dados PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/shiori_db
DB_USERNAME=postgres
DB_PASSWORD=sua_senha_forte_do_banco_aqui

# Hibernate / JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# Criptografia Simétrica em Repouso LGPD (AES-256)
# Gere uma chave de 256 bits via terminal: openssl rand -hex 32
SHIORI_CRYPTO_KEY=gere_uma_chave_hex_com_openssl_rand_hex_32
# Alias suportado: SHIORI_CRYPTO_SECRET_KEY

# Autenticação e Segurança (JWT)
# Gere uma chave de 256 bits via terminal: openssl rand -hex 32
JWT_SECRET=gere_uma_chave_hex_com_openssl_rand_hex_32
JWT_EXPIRATION_MS=86400000
# Aliases suportados: SHIORI_JWT_SECRET, JWT_EXPIRATION

# Armazenamento Compatível com S3 (AWS, R2, MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=sua_access_key
S3_SECRET_KEY=sua_secret_key
S3_REGION=us-east-1
S3_BUCKET_NAME=shiori-media

# Bootstrap do Administrador Master (ROLE_ADMIN)
ADMIN_DEFAULT_PASSWORD=sua_senha_mestra_forte_aqui

# CORS - Origens Permitidas (Use '*' para clientes desacoplados ou liste origens separadas por vírgula)
CORS_ALLOWED_ORIGINS=*
